{
  "name": "lionclaw",
  "version": "4.0.0",
  "description": "Personal AI assistant desktop app",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:mcps && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build:mcps && electron-vite build && npm run prepare:cursor-payload && electron-builder",
    "dist:mac": "npm run build:mcps && electron-vite build && npm run prepare:cursor-payload && electron-builder --mac",
    "dist:win": "npm run build:mcps && electron-vite build && npm run prepare:cursor-payload && electron-builder --win",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "tsc --noEmit -p electron/tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p src/tsconfig.json",
    "build:mcps": "node scripts/build-all-mcps.js",
    "build:excalidraw-bundle": "esbuild scripts/excalidraw-entry.js --bundle --outfile=resources/excalidraw-bundle.js --format=iife --global-name=ExcalidrawBundle --define:process.env.NODE_ENV=\\\"production\\\" --minify",
    "prepare:codegraph": "node scripts/prepare-codegraph-runtime.js",
    "build:cursor-sidecar": "node scripts/build-cursor-sidecar.js",
    "prepare:cursor-node": "node scripts/prepare-cursor-node-runtime.js",
    "prepare:cursor-payload": "node scripts/build-cursor-sidecar.js --force --with-deps && node scripts/prepare-cursor-node-runtime.js",
    "postinstall": "npm run prepare:codegraph && npm run build:mcps && npm run build:cursor-sidecar",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3,node-pty",
    "rebuild:node": "npm rebuild better-sqlite3 node-pty",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "author": "LionLabs",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@anthropic-ai/sdk": "^0.123.0",
    "@colbymchenry/codegraph": "^0.9.9",
    "@cursor/sdk": "1.0.30",
    "@dagrejs/dagre": "^2.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@excalidraw/excalidraw": "^0.18.0",
    "@google/genai": "^1.45.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@moonshot-ai/kimi-agent-sdk": "^0.1.8",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.80",
    "@openai/codex": "^0.162.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/d3": "^7.4.3",
    "@types/react-window": "^1.8.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "codeburn": "^0.9.6",
    "cohere-ai": "^7.20.0",
    "cron-parser": "^5.5.0",
    "csv-parse": "^6.2.1",
    "d3": "^7.9.0",
    "electron-updater": "^6.8.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.9.3",
    "fuse.js": "^7.5.0",
    "g": "^2.0.1",
    "googleapis": "^171.4.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "ignore": "^7.0.12",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^24.1.3",
    "jsonrepair": "^3.14.0",
    "keytar": "^7.9.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "node-pty": "^1.0.0",
    "node-telegram-bot-api": "^0.67.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.11",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "sqlite-vec": "^0.1.7",
    "turndown": "^7.2.4",
    "unpdf": "^1.4.0",
    "web-tree-sitter": "^0.26.13",
    "which": "^5.0.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/glob": "^8.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.5.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "prettier": "3.9.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
